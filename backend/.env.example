PORT=3000
HOST=0.0.0.0
DATABASE_URL=./rotshop.db
REDIS_URL=redis://localhost:6379
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
ADMIN_JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@rotshop.local
ADMIN_PASSWORD=admin
DOCKER_SOCKET=/var/run/docker.sock
LOG_LEVEL=info
CORS_ORIGIN=*

# Sandbox runner mode:
#   auto     — try docker, fall back to simulate if daemon unreachable (default)
#   docker   — fail jobs when docker is unavailable
#   simulate — never touch docker; mark every submission as passed after a short delay (great for demos)
#   skip     — don't process sandbox jobs at all
SANDBOX_MODE=auto

# Container pool tuning for the live proxy (seconds)
PROXY_CONTAINER_IDLE_SECONDS=300
PROXY_CONTAINER_PORT_RANGE_START=4100
PROXY_CONTAINER_PORT_RANGE_END=4999
